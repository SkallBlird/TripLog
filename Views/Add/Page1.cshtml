@model DestinationViewModel
@{
    ViewData["Title"] = "Add Trip";
}

<h2>Destination and Dates</h2>

<form asp-action="Page1" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Destination"></label>
        <input asp-for="Destination" class="form-control" />
        <span asp-validation-for="Destination" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StartDate"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="EndDate"></label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Accommodation"></label>
        <input asp-for="Accommodation" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Next</button>
</form>

<form asp-action="Cancel" method="post" class="mt-2">
    <button type="submit" class="btn btn-secondary">Cancel</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}