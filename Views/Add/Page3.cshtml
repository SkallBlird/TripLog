@model ActivitiesViewModel
@{
    ViewData["Title"] = "Things To Do";
}

<h2>Things To Do</h2>

<form asp-action="Page3" method="post">
    <div class="mb-3">
        <label asp-for="ThingToDo1"></label>
        <input asp-for="ThingToDo1" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ThingToDo2"></label>
        <input asp-for="ThingToDo2" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ThingToDo3"></label>
        <input asp-for="ThingToDo3" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

<form asp-action="Cancel" method="post" class="mt-2">
    <button type="submit" class="btn btn-secondary">Cancel</button>
</form>